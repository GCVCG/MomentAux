#!/bin/bash
#SBATCH --job-name=ms_vitl3
#SBATCH --account=${CLUSTER_ACCOUNT:?set CLUSTER_ACCOUNT}
#SBATCH --qos=acc_resc
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=80
#SBATCH --time=23:50:00
#SBATCH --output=${CLUSTER_SCRATCH}/momentstem/logs/%x_%j.out
#
# ===== LANE vitl3: BLOCK F OF THE LIMITATIONS CAMPAIGN (2026-08-23) =====
# ViT-L/16 @224 (diagin100_vitl_*, diagin100e200_vitl_*) and the 300-epoch
# ViT-S/ViT-B convergence arms (diagin100e300_*). SLOTS=1 (GPU-bound, as r1).
# THE WALLTIME PROBLEM AND HOW THIS LANE SOLVES IT: QOS MaxWall is 24h and a
# ViT-L cell is ~18h (100 ep) / ~37h (200 ep) on one H100, so a run cannot
# finish inside one job. Every block-F config carries `resume_every: 10`:
# train.py writes a full training state to <seed_dir>/resume.pt every 10
# epochs and, when started again on a (config, seed) whose final.json does
# not exist, RESUMES from it; a (config, seed) whose final.json exists is a
# SKIP no-op (the completed-run guard). So the same worklist can simply be
# run again by a LATER job set and every unfinished cell picks up where it
# left off.
# WHY THE REPEATS ARE SEPARATE LANES WITH A DEPENDENCY, NOT REPEATED LINES:
# train.py's run lock is flock-based and NODE-LOCAL on GPFS (ledger,
# 2026-08-13), so two nodes CAN train the same seed dir concurrently -- the
# exact wrong-epoch race of 2026-08-06. Repeating a line inside one worklist
# would let a slot that frees early (a 9h ViT-S@300 cell) claim the repeat of
# a ViT-L cell still live on another node. Instead: lane vitl runs every line
# once; lanes vitl2 and vitl3 carry the SAME 24 lines and are submitted with
# --dependency=afterany:<all jobs of the previous lane>, so they cannot start
# until every job of the previous set has ended (walltime or completion).
# Finished cells SKIP in seconds; unfinished ones resume.
# DEADLINE=7h: a slot that frees after 7h claims nothing more, so every task
# claimed in this job has >=16.8h of wall left (the ViT-B@300ep estimate) --
# anything still unfinished is resumed by the next lane.
#
# MareNostrum5 grid worker (2026-07-22). One job = one node = 4 H100s, each
# running an INDEPENDENT training stream that pulls the next task atomically
# from the shared worklist. Submit N of these for 4N concurrent GPUs.
#
# Why a shared queue rather than pre-partitioned job scripts: the tasks span
# ~1000x in cost (a 1% ViT cell vs a 100% SimCLR cell), so any static split
# leaves GPUs idle. Pulling on demand keeps all 4 busy until the queue drains.

set -uo pipefail
source ${CLUSTER_SCRATCH}/momentstem/env.sh
cd "$MS_ROOT/repo"

# worklist.bsc is THE live BSC queue (regenerated by every reconcile).
# worklist.txt is the original 2026-07-22 full list and is now stale --
# pointing here shipped a regression on 2026-08-03 that had the cluster
# working the old 2712-line list while the rebuilt queues went unread.
WORKLIST=$MS_ROOT/worklist.vitl3
CTR=$MS_ROOT/queue.counter.vitl3
LOCK=$MS_ROOT/queue.lock.vitl3
export OUT=$MS_ROOT/runs
N=$(wc -l < "$WORKLIST")

# --- stage the datasets into RAM: tin is 110k small files and GPFS is even
# worse at that than BeeGFS. Everything else is symlinked so one --data-root
# serves every dataset. Falls back to plain GPFS if /dev/shm is too small.
STAGE=/dev/shm/ms_$SLURM_JOB_ID
if mkdir -p "$STAGE" 2>/dev/null; then
    ln -sfn "$MS_DATA"/* "$STAGE"/ 2>/dev/null
    rm -f "$STAGE/tiny-imagenet-200"
    if unzip -q "$MS_DATA/tiny-imagenet-200.zip" -d "$STAGE" 2>/dev/null; then
        export DR=$STAGE
    else
        export DR=$MS_DATA
    fi
    trap 'rm -rf "$STAGE"' EXIT
else
    export DR=$MS_DATA
fi
echo "host=$(hostname) DR=$DR tasks=$N"
nvidia-smi --query-gpu=index,name --format=csv,noheader

DEADLINE=$(( $(date +%s) + 7*3600 ))   # stop CLAIMING new work at 7h (23h50 job): any task claimed has >=16.8h, the ViT-B@300ep estimate

# Initialize the counter ONCE, under the lock, and only if it is absent or
# empty -- so a worker starting late never resets a counter already in use.
flock "$LOCK" bash -c "[ -s '$CTR' ] || echo 0 > '$CTR'"

IDLE_MAX=${MS_IDLE_MAX:-15}      # ~15 min of polling before a drained worker exits

worker () {                              # $1 = GPU index
    export CUDA_VISIBLE_DEVICES=$1
    IDLE=0
    while :; do
        [ "$(date +%s)" -ge "$DEADLINE" ] && { echo "[gpu$1] deadline"; break; }
        # The claim is BOUNDED BY THE LIVE WORKLIST, read under the same lock.
        # A worker that finds no work must not consume an index: the old form
        # incremented unconditionally and then decided it was out of range, so
        # every idling worker burned one index per poll and the shared counter
        # ran away from the file (observed 2026-08-26 at 396 against a 299-line
        # worklist). Two consequences, both silent: appended tasks landed below
        # the counter and were never claimed, and any claim taken just before
        # an append was DISCARDED rather than run, losing one task per live
        # worker. Same family as the 2026-08-03 skip -- claims are atomic,
        # execution is not. Reading the length inside the claim also makes
        # appends work with no padding and no cached N.
        i=$(flock "$LOCK" bash -c "
                v=\$(cat '$CTR' 2>/dev/null)
                case \"\$v\" in ''|*[!0-9]*) exit 1 ;; esac
                n=\$(wc -l < '$WORKLIST' 2>/dev/null || echo 0)
                if [ \"\$v\" -ge \"\$n\" ]; then echo DRAINED; exit 0; fi
                echo \$((v+1)) > '$CTR'
                echo \$v") \
            || { echo "[gpu$1] counter unreadable/corrupt, backing off"; sleep 10; continue; }
        if [ "$i" = DRAINED ]; then
            # Do NOT exit immediately: on 2026-08-05 two of four GPUs sat at 0%
            # for hours because their workers drained while stragglers ran on
            # the others, and an exited worker never comes back even when new
            # tasks are appended. Poll for a bounded window instead, then give
            # up so the keeper's "no workers live -> reconcile" path can fire.
            IDLE=$((IDLE + 1))
            if [ "$IDLE" -ge "$IDLE_MAX" ]; then
                echo "[gpu$1] queue drained (idled ${IDLE}x)"; break
            fi
            sleep 60
            continue
        fi
        i=$((i+1))
        IDLE=0
        cmd=$(sed -n "${i}p" "$WORKLIST")
        if [ -z "$cmd" ]; then
            # An empty line means our cached N is stale -- the worklist was
            # REPLACED under us (a reconcile, or a manual swap). Re-read the
            # real length and stop if we are past it. Without this the worker
            # spins: empty line -> continue -> instant re-claim, which on
            # 2026-08-03 raced the shared counter from 0 to 1698 against a
            # 615-line file and CONSUMED ~580 real tasks without running them.
            N=$(wc -l < "$WORKLIST" 2>/dev/null || echo 0)
            [ "$i" -ge "$N" ] && { echo "[gpu$1] queue drained (worklist now $N)"; break; }
            sleep 1
            continue
        fi
        echo "[gpu$1] TASK $i/$N :: ${cmd:0:110}"
        # LANE-PREFIXED (2026-08-06): see bsc_big.sbatch -- both lanes wrote
        # logs/task_${i}.log and clobbered each other's failure diagnostics.
        eval "$cmd" > "$MS_ROOT/logs/${SLURM_JOB_NAME}_task_${i}.log" 2>&1 \
            && echo "[gpu$1] OK   $i" || echo "[gpu$1] FAIL $i (see logs/${SLURM_JOB_NAME}_task_${i}.log)"
    done
}

# CONCURRENCY PER GPU (2026-08-05, measured not assumed): a live node showed
# 0-6% GPU utilisation and 2-3GB of 65GB in use -- these 32-64px cells are
# DATALOADER-bound, so one training per H100 wastes ~95% of it. Run SLOTS
# trainings per GPU instead.
# The binding constraint is CPU, not GPU: the node has 160 cores (measured
# 2026-08-05 with nproc --all; an earlier note said 80), and the
# ledger records a 5x SLOWDOWN when workers oversubscribe cores (load 113 on
# 16 cores => 44 min/seed vs 5.4). Budget ~= SLOTS*4*(num_workers+1) threads
# and keep it under 80.
# *** GPU MEMORY IS ALSO BINDING, NOT JUST CPU (2026-08-06, measured the hard
# way): SLOTS=8 was tuned on 32px ResNet-18 cells that use 1-5GB each. When the
# queue head became diagdepth r34/r50 and diagin64 cells -- 19.5GB apiece -- 8
# slots on a 63.29GiB card OOM'd instantly: five fresh grid jobs logged OK=0 /
# FAIL=215, with 187 task logs carrying torch.OutOfMemoryError, and the claim
# counter burned 359 tasks in minutes WITHOUT RUNNING THEM (claims are atomic,
# execution is not -- the same asymmetry as the 2026-08-03 spin).
# 3 slots x 19.5GB = 58.5GB fits with headroom; light cells still get 3-way
# overlap, which was most of the win. Raise via MS_SLOTS only for a queue known
# to be uniformly small.
# R1 LANE OVERRIDE: SLOTS=1, NOT 3. These are ViT-S @224px cells and they are
# GPU-bound, not dataloader-bound: the ViT-B E4 pair measured 5.3h/run alone
# against 11.3h/run when two shared a card, i.e. sharing bought nothing and
# doubled the wall clock. One training per H100; parallelism comes from nodes.
SLOTS=${MS_SLOTS:-1}
# Reduces fragmentation when several trainings share a card, which is exactly
# the regime here (the OOM trace recommended it explicitly).
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}
echo "concurrency: $SLOTS training(s) per GPU = $((SLOTS*4)) per node"
# ROUND-ROBIN over GPUs, not GPU-major. The loops used to nest the other way
# (all of gpu0's slots, then gpu1's ...), so slots claim in spawn order and a
# queue with fewer tasks than slots puts EVERY task on GPU 0. Measured on the
# ImageNet lane: 2 tasks left, both on gpu0 at 100% while gpus 1-3 sat at 0 MiB,
# running 3-5x slower than the same cells had on a free GPU. Interleaving means
# the first 4 claims land on 4 different GPUs.
for k in $(seq 1 "$SLOTS"); do
    for g in 0 1 2 3; do worker "$g" & done
done
wait
echo "BSC_WORKER_COMPLETE"
