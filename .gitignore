# Operational files carrying machine addresses and absolute home paths.
# These are scheduling glue for our two workstations, not part of the
# released artifact; the released harness is the configs, the single training
# entry point and the audit scripts, which are machine-independent.
scripts/queue_sf_*.txt
scripts/sync_sf_*.sh
logs/sync_sf_*.log
logs/so2sat_push.log
# no separate submission copy: paper/ is the single source, and a duplicate
# tree drifts from it the moment either side is edited. See
# paper/SUBMISSION_FILES.md for what to upload.
paper/submission/

# release assets are built on demand, never committed
dist/
